"use client";

import { useRouter } from 'next/navigation';
import { useUser } from '@clerk/nextjs';
import { useState, useEffect } from 'react';
import Image from 'next/image';
import { motion } from 'framer-motion';
import React from 'react';

const BACKEND_URL = "http://127.0.0.1:8000";

type Role = 'lecturer' | 'student';

export default function RoleSelection() {
  const router = useRouter();
  const { user, isLoaded } = useUser();
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string>("");
  const [selectedRole, setSelectedRole] = useState<Role | null>(null);

  // Check existing role on mount
  useEffect(() => {
    const checkUserRole = async () => {
      if (!user?.id) return;
      
      try {
        console.log('Checking user role for:', user.id);
        const response = await fetch(`${BACKEND_URL}/get-user-role?userId=${user.id}`);
        console.log('Role check response status:', response.status);
        
        // If 404, the user hasn't selected a role yet - this is expected for new users
        if (response.status === 404) {
          console.log('No role found for user - this is normal for new users');
          return;
        }

        // Handle other error cases
        if (!response.ok) {
          const data = await response.json();
          console.error('Error response from get-user-role:', data);
          throw new Error(data.detail || 'Failed to get user role');
        }

        const userData = await response.json();
        
        if (userData.role) {
          if (userData.role === 'student') {
            try {
              const studentResponse = await fetch(`${BACKEND_URL}/get-student-info?userId=${user.id}`);
              const studentData = await studentResponse.json();

              if (studentResponse.ok && (!studentData || !studentData.isComplete)) {
                router.push('/student-registration');
                return;
              }
            } catch (err) {
              console.error('Error checking student info:', err);
              setError('Failed to verify student registration status');
              return;
            }
          }
          // If all checks pass, redirect to home
          router.push('/home');
        }
      } catch (err) {
        console.error('Error checking user role:', err);
        setError(err instanceof Error ? err.message : 'Failed to check user role');
      }
    };

    if (isLoaded && user) {
      checkUserRole();
    }
  }, [isLoaded, user, router]);

  const handleRoleSelection = async (selectedRole: Role) => {
    console.log('Role selection initiated:', selectedRole);
    
    if (!user?.id || !user?.emailAddresses[0]?.emailAddress) {
      console.error('Missing user info:', { 
        userId: user?.id, 
        email: user?.emailAddresses[0]?.emailAddress 
      });
      setError('User information not available. Please sign in again.');
      return;
    }

    setLoading(true);
    setError("");
    setSelectedRole(selectedRole);

    try {
      console.log('Sending role selection request:', {
        userId: user.id,
        email: user.emailAddresses[0].emailAddress,
        name: user.fullName || user.firstName || 'Unknown',
        role: selectedRole
      });
      
      const response = await fetch(`${BACKEND_URL}/set-user-role`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          userId: user.id,
          email: user.emailAddresses[0].emailAddress,
          name: user.fullName || user.firstName || 'Unknown',
          role: selectedRole,
        }),
      });
      
      console.log('Set role response status:', response.status);

      let data;
      try {
        data = await response.json();
      } catch (parseErr) {
        console.error('Failed to parse server response:', parseErr);
        throw new Error('Invalid response from server');
      }

      if (!response.ok) {
        throw new Error(data?.detail || 'Failed to set user role');
      }

      // Only navigate on successful role setting
      if (selectedRole === 'lecturer') {
        router.push('/home');
      } else {
        router.push('/student-registration');
      }
    } catch (err) {
      console.error('Error setting role:', err);
      let errorMessage = 'Failed to set user role';
      
      if (err instanceof Error) {
        errorMessage = err.message;
      } else if (err instanceof TypeError && err.message.includes('fetch')) {
        errorMessage = 'Could not connect to the server. Please check if the backend is running.';
      }
      
      console.error('Detailed error:', errorMessage);
      setError(errorMessage);
    } finally {
      setLoading(false);
    }
  };

  // Loading state
  if (!isLoaded) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-gradient-to-br from-[#0F1828] to-[#1B2B44]">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500 mx-auto"></div>
          <p className="text-white mt-4 animate-pulse">Loading...</p>
        </div>
      </div>
    );
  }

  // Show error if user data is not available
  if (!user || !user.id || !user.emailAddresses[0]?.emailAddress) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-gradient-to-br from-[#0F1828] to-[#1B2B44]">
        <div className="text-center bg-red-500/10 p-6 rounded-lg">
          <Image src="/icons/error.svg" alt="Error" width={48} height={48} className="mx-auto mb-4" />
          <div className="text-red-500">User information not available. Please sign in again.</div>
        </div>
      </div>
    );
  }

  const roleCards = [
    {
      role: 'student' as const,
      title: 'Student',
      icon: '/icons/student.svg',
      description: 'Join classes and mark your attendance',
      color: 'bg-blue-600',
      hoverColor: 'hover:bg-blue-700',
      disabledColor: 'disabled:bg-blue-400'
    },
    {
      role: 'lecturer' as const,
      title: 'Lecturer',
      icon: '/icons/lecturer.svg',
      description: 'Create classes and manage attendance',
      color: 'bg-green-600',
      hoverColor: 'hover:bg-green-700',
      disabledColor: 'disabled:bg-green-400'
    }
  ];

  return (
    <div className="min-h-screen bg-gradient-to-br from-[#0F1828] to-[#1B2B44] p-4 flex items-center justify-center">
      <motion.div 
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.5 }}
        className="w-full max-w-4xl"
      >
        <div className="text-center mb-12">
          <motion.h1 
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ delay: 0.2 }}
            className="text-4xl font-bold text-white mb-4"
          >
            Welcome to VMeet
          </motion.h1>
          <motion.p 
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ delay: 0.3 }}
            className="text-gray-400 text-lg"
          >
            Please select your role to continue
          </motion.p>
        </div>

        <div className="grid md:grid-cols-2 gap-6 px-4">
          {roleCards.map((card, index) => (
            <motion.div
              key={card.role}
              initial={{ opacity: 0, x: index === 0 ? -20 : 20 }}
              animate={{ opacity: 1, x: 0 }}
              transition={{ delay: 0.4 + index * 0.1 }}
              onClick={() => setSelectedRole(card.role)}
              className={`
                cursor-pointer rounded-xl p-6 
                ${selectedRole === card.role ? 'bg-[#2C3C56] ring-2 ring-blue-500' : 'bg-[#1B2B44]'}
                transition-all duration-200 hover:transform hover:scale-105 hover:shadow-xl
              `}
            >
              <div className="text-center">
                <div className="rounded-full bg-opacity-10 p-4 inline-block mb-4">
                  <Image src={card.icon} alt={card.title} width={48} height={48} />
                </div>
                <h3 className="text-xl font-semibold text-white mb-2">{card.title}</h3>
                <p className="text-gray-400 mb-6">{card.description}</p>
                <button
                  onClick={(e) => {
                    e.stopPropagation();
                    handleRoleSelection(card.role);
                  }}
                  disabled={loading || !isLoaded}
                  className={`
                    w-full rounded-lg px-4 py-3 font-medium text-white 
                    transition-all duration-200
                    ${card.color} ${card.hoverColor} ${card.disabledColor}
                    transform hover:scale-105
                    disabled:cursor-not-allowed
                    ${loading && selectedRole === card.role ? 'animate-pulse' : ''}
                  `}
                >
                  {loading && selectedRole === card.role ? (
                    <div className="flex items-center justify-center">
                      <div className="animate-spin rounded-full h-5 w-5 border-t-2 border-b-2 border-white mr-2"></div>
                      Setting up...
                    </div>
                  ) : (
                    `Continue as ${card.title}`
                  )}
                </button>
              </div>
            </motion.div>
          ))}
        </div>

        {error && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="mt-8 rounded-lg bg-red-500/10 p-4 text-center"
          >
            <div className="flex items-center justify-center space-x-2">
              <Image src="/icons/error.svg" alt="Error" width={20} height={20} />
              <p className="text-red-500">{error}</p>
            </div>
          </motion.div>
        )}
      </motion.div>
    </div>
  );
}
